# =============================================================================
# NAD — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# The name shown in the browser tab and login page (customise freely)
APP_NAME="NAD"

# Secret key used for JWT signing and encrypting stored secrets.
# Generate with: openssl rand -base64 32
APP_SECRET="change-me-to-a-random-string"

# Default canonical dashboard URL (origin only). Used for the secure-login
# handoff and as the fallback access-lock target; administrators can override
# it at runtime in Settings → General. In development this is typically
# http://localhost:3000
APP_URL="http://localhost:3000"

# Timezone for display purposes (IANA format)
APP_TIMEZONE="Europe/London"

# Host interface used by Docker Compose. Keep this on the intended LAN address.
NAD_BIND_ADDRESS="127.0.0.1"

# Hosted first-party Marketplace base URL. Leave this alone to target the
# public first-party catalog, or replace it with your own compatible origin.
NAD_MARKETPLACE_URL="https://nad.robrolabs.com"

# manual: never contact the Marketplace; administrators upload .nadmod files
# online: allow catalog/download requests to NAD_MARKETPLACE_URL
NAD_MARKETPLACE_MODE="online"

# Reviewed multi-architecture image pulled by the supported Docker Compose
# installation. Pin a release tag; do not use latest.
NAD_IMAGE="ghcr.io/robrolabs/nad:0.3.2"

# Optional immutable build metadata for developer/source image builds. Set
# these through the shell or a Compose environment file only when producing a
# reviewed image with docker-compose.build.yml.
# NAD_VERSION="0.3.2"
# NAD_GIT_REVISION="full-40-character-git-sha"
# NAD_BUILD_DATE="2026-08-10T12:34:56Z"
# NAD_SOURCE_URL="https://github.com/robrolabs/nad"
# NAD_IMAGE_TAG="0.3.2-abcdef123456"

# Development-only override when Deno is not on PATH. The production image
# includes the pinned runtime and sets this automatically.
# NAD_DENO_PATH="/absolute/path/to/deno"

# Never enable this in production. It exists only for local SDK iteration.
# NAD_ALLOW_UNSIGNED_MODULES="true"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default): path to the database file (relative to project root)
DATABASE_URL="file:./data/nad.db"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Auth.js secret. Generate a separate value with: openssl rand -base64 32
# Keeping this explicit avoids environment-file interpolation differences between runtimes.
AUTH_SECRET="change-me-to-a-second-random-string"

# Auth.js URL (must match APP_URL)
AUTH_URL="http://localhost:3000"

# Authentik OIDC (future — uncomment when ready)
# AUTHENTIK_ISSUER="https://auth.example.com/application/o/nad/"
# AUTHENTIK_CLIENT_ID=""
# AUTHENTIK_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# SMTP, Telegram, and ntfy channels are configured in the application
# at Settings → Notifications, with secrets encrypted at rest.
# No environment variables are required here.
