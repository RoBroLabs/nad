{
  "name": "nad",
  "version": "0.3.3",
  "private": true,
  "description": "Modular self-hosted homelab mission control dashboard",
  "license": "AGPL-3.0-only",
  "author": "Robin Brown <robin@robrolabs.com>",
  "homepage": "https://github.com/robrolabs/nad",
  "repository": {
    "type": "git",
    "url": "https://github.com/robrolabs/nad.git"
  },
  "bugs": "https://github.com/robrolabs/nad/issues",
  "keywords": [
    "homelab",
    "self-hosted",
    "dashboard",
    "plugins",
    "marketplace",
    "monitoring",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "NAD_BUILD_EPHEMERAL_DB=1 next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "node scripts/backup.mjs",
    "db:backup:verify": "node scripts/verify-backup.mjs",
    "db:backup:maintain": "node scripts/backup-maintenance.mjs",
    "admin:recover": "node scripts/admin-recover.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "contracts:check": "node scripts/check-module-contracts.mjs",
    "release:bundle": "node scripts/generate-install-bundle.mjs",
    "release:bundle:verify": "node scripts/verify-install-bundle.mjs",
    "ci:gate": "bash scripts/ci-release-gate.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "ajv": "8.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.5",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^1.5.0",
    "react-resizable": "^4.0.2",
    "shadcn": "4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "yazl": "3.3.1"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
